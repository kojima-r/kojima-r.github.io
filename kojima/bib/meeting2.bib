@inproceedings{Matsubayashi_2015_1219,
  title = {複数のマイクロフォンアレイで測る野鳥の位置},
  author = {松林 志保 and 小島 諒介 and 中臺 一博 and 鈴木 麗璽},
  yomi = {まつばやし しほ and こじま りょうすけ and なかだい かずひろ and すずき れいじ},
  year = {2015},
  month = {Nov.},
  booktitle = {第10回バードリサーチ大会},
  abstract = {複数のマイクで構成されるデバイスであるマイクロホンアレイを用いて音源の方向や位置を定位したり、定位した音源を分離する技術が急速に発展している。この技術の野鳥研究への応用は、従来の単一のマイクによる録音と比べてより豊富な生態情報の記録を可能にするため、生態理解へ大きな貢献を果たすことが期待される。本稿では複数のマイクロホンアレイから得られる音源の方角を総合することで、音源を定位できる可能性を示した。},
  publisher = {認定NPO法人 バードリサーチ},
  address = {名古屋大学},
  url="http://honda-ri.jp/publications/1219"
}

